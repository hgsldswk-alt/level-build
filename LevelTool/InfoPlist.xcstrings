{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水平仪"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "水平儀"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在取景或为记录拍照时使用相机，不录音、不打开闪光灯。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the camera only for viewfinder alignment or record photos. No audio is recorded and flash stays off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在取景或為紀錄拍照時使用相機，不錄音、不開啟閃光燈。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你选择的取景照片和分享图保存到相册。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save viewfinder photos and share cards you choose to your photo library."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將你選擇的取景照片和分享圖儲存至相簿。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
