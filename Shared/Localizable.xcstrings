      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取景、挂画、调平、语音读数和目标值。基本测量、校准、记录与 CSV 永远免费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera alignment, hanging plans, leveling, spoken readings and targets. Basic measurements, calibration, records and CSV stay free."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取景、掛畫、調平、語音讀數和目標值。基本測量、校準、紀錄與 CSV 永遠免費。"
          }
        }
